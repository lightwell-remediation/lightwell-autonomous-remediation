# Agent runtime configuration — copy to secrets/secrets.env and fill in.
#
#   cp secrets/secrets.template.env secrets/secrets.env
#   chmod 600 secrets/secrets.env
#
# secrets/secrets.env is gitignored. NEVER commit real values.
# See docs/agent-runtime.md for how each value is used.

# --- Red Hat MaaS (inference) -------------------------------------------
# Gateway base URL, no trailing /v1 — the harness appends the API path.
MAAS_BASE_URL=CHANGE_ME

# MaaS API key.
MAAS_API_KEY=CHANGE_ME

# Primary model alias from the MaaS catalog. Every run was validated with
# claude-sonnet-4-6, and a MaaS key does not get it by default: request access
# to it first. Verify your key lists it with:
#   curl -H "Authorization: Bearer $MAAS_API_KEY" "$MAAS_BASE_URL/v1/models"
MAAS_MODEL=claude-sonnet-4-6

# Small/fast model used for background work. Leave empty if the catalog has
# none — the runtime then points every model slot at MAAS_MODEL.
MAAS_SMALL_MODEL=

# --- GitHub (repository access) -----------------------------------------
# Fine-grained PAT scoped to APP_REPO only:
#   Contents: Read and write | Pull requests: Read and write | Metadata: Read
GITHUB_TOKEN=CHANGE_ME

# Application repository the agent remediates, as owner/repo.
APP_REPO=CHANGE_ME

# Commit identity used by the agent.
GIT_AUTHOR_NAME=lightwell-agent
GIT_AUTHOR_EMAIL=lightwell-agent@users.noreply.github.com

# --- Lightwell (vulnerability source) -----------------------------------
# Path A only; leave every LW_* empty on path B (docs/replicate.md). The
# runtime uses the credentials to resolve the Lightwell Maven repositories and
# to fetch the vulnerability record; they never reach the agent.
# Quote these if the token contains shell metacharacters — `source` would
# otherwise let bash interpret part of it. Then do NOT pass this file to podman
# with --env-file: it does not strip quotes, the container receives the value
# with them attached, and every authenticated request fails with a 401 that
# looks like a credential problem. Source the file and pass -e VAR instead.
# See docs/agent-runtime.md — Quoted secrets and --env-file.
LW_USERNAME=
LW_PASSWORD=
# URL of the Lightwell remediated Maven repository. The application's
# settings.xml reads it as ${env.LW_MAVEN_REPO_URL} rather than naming it, so
# the repository location stays out of every published repository.
LW_MAVEN_REPO_URL=
# Directory of the Lightwell OSV records for Java remediations, the one that
# serves x_RHLW-CVE-2026-68079-4.2.2.json. With it, scripts/run-remediation.sh
# takes a Lightwell id and the pipeline fetches the record itself. Same
# credentials as above.
LW_OSV_BASE_URL=
# The Lightwell rebuild that remediates the demo CVE, as a Maven version. Only
# read by the tests and scripts that resolve it for real
# (agent-runtime/test/fixtures.test.sh, scripts/verify-backport-resolves.sh);
# the fixtures in git carry a placeholder instead.
LW_REMEDIATED_VERSION=

# --- Trusted Profile Analyzer (inventory validation) --------------------
# Optional. Where set, the regenerated SBOM is uploaded to TPA before the pull
# request is opened, and what TPA reports about the vulnerability goes in the
# pull request body. Leave all four empty to run without TPA.
#
# An OIDC client issued for this (client-credentials grant), never a person's
# login. The token endpoint is the realm's:
#   https://<keycloak-host>/realms/<realm>/protocol/openid-connect/token
# Milestone 1 points at a TPA on a separate cluster — docs/workarounds.md.
TPA_URL=
TPA_TOKEN_URL=
TPA_CLIENT_ID=
TPA_CLIENT_SECRET=

# --- Optional -----------------------------------------------------------
# Turn budget per session. The runtime exits non-zero if it is exhausted.
# A complete remediation — analyse, write an exploit test, patch, run the build,
# commit, push, open the pull request — took 21 turns when it succeeded and 34
# when it did not, so 25 is not enough for the real loop.
#
# The analyze role settled at 9-10 turns once the runtime stopped making the
# agent discover what it could be handed (ADR-0005). Before that it ran 41 to
# 108 turns on identical input and failed one run in four; the fix was an
# inventory of the repository's files, not a bigger budget.
MAX_TURNS=40

# Output tokens per reply. The runtime defaults to 2048 because the gateway
# drops requests past roughly 60 seconds, so the real ceiling is the model's
# throughput times that window. Raise it only after measuring the model you
# pinned above. See docs/agent-runtime.md — Known limitations.
# CLAUDE_CODE_MAX_OUTPUT_TOKENS=2048

# OpenTelemetry export (opt-in). Leave unset to disable. See ADR-0003.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
