# GitHub App used by scripts/provision-app-repo.sh to mint, per deployment, a
# token scoped to one repository. Copy to secrets/github-app.env (gitignored):
#
#   cp secrets/github-app.template.env secrets/github-app.env
#   chmod 600 secrets/github-app.env
#
# Created once, by hand — see the provision-app-repo skill, step 1.
# NEVER commit real values, and keep the private key OUTSIDE this repository.

# App ID (or Client ID) from the App's settings page. It is the JWT issuer.
GH_APP_ID=CHANGE_ME

# Installation ID: the number at the end of
# https://github.com/organizations/<org>/settings/installations/<id>
GH_APP_INSTALLATION_ID=CHANGE_ME

# Private key generated for the App, mode 600, outside the repository.
GH_APP_PRIVATE_KEY_FILE=/home/CHANGE_ME/.config/lightwell/github-app/key.pem

# Organization that owns the templates and receives the per-deployment copies.
GH_APP_OWNER=lightwell-remediation
